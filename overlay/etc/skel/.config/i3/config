# MiniBang i3 config

set $mod Mod4
floating_modifier $mod

focus_follows_mouse yes

# Keyboard layout (mbinstall seds this to the user's chosen layout at install time)
exec_always --no-startup-id setxkbmap us

# Background
exec_always --no-startup-id feh --bg-fill ~/Pictures/wallpaper.png

font pango:DejaVu Sans Mono 12

# MiniBang theme — sourced from ~/.Xresources (single source of truth, see
# that file's comment); fallback hex only applies if xrdb has no value merged.
set_from_resource $bg      i3.background #1a1620
set_from_resource $bg-alt  i3.bgAlt      #3a2f52
set_from_resource $fg      i3.foreground #ece8f8
set_from_resource $fg-dim  i3.fgDim      #a99cc4
set_from_resource $accent  i3.accent     #8b5cf6
set_from_resource $lavender i3.lavender  #c3bce6
set_from_resource $urgent  i3.urgent     #e0623f

# class                 border   backgr.  text   indicator  child_border
client.focused           $accent  $bg      $fg    $accent    $accent
client.unfocused         $bg-alt  $bg-alt  $fg-dim $bg-alt   $bg-alt
client.focused_inactive  $bg-alt  $bg-alt  $fg-dim $bg-alt   $bg-alt
client.urgent            $urgent  $urgent  $fg    $urgent    $urgent

# Terminal
set $term urxvt
bindsym $mod+Return exec --no-startup-id $term
for_window [class="URxvt"] floating disable

# Launcher
bindsym $mod+space exec dmenu_run -fn "DejaVu Sans Mono:size=12" -nb '#1a1620' -nf '#ece8f8' -sb '#8b5cf6' -sf '#ece8f8'

# Web (terminal browser, no GUI browser shipped)
bindsym $mod+w exec --no-startup-id $term -e links https://archbang.org

# Screenshots
bindsym $mod+p exec scrot ~/Pictures/%d%m%y%H%M%S.png
bindsym $mod+Shift+s exec scrot -s ~/Pictures/%d%m%y%H%M%S.png

# Network menu (nmtui, no dmenu-based network UI shipped)
bindsym $mod+n exec $term -e nmtui

# Lock screen
bindsym $mod+l exec i3lock -c 1a1620

# Kill focused window
bindsym $mod+q kill

# Change focus
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused window
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split
bindsym $mod+h split h
bindsym $mod+v split v

# Fullscreen
bindsym $mod+f fullscreen toggle

# Layout
bindsym $mod+e layout toggle split
bindsym $mod+s layout stacking
bindsym $mod+z layout tabbed

# Floating
bindsym $mod+Shift+space floating toggle
bindsym $mod+Ctrl+space focus mode_toggle

# Focus parent/child
bindsym $mod+a focus parent

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9

# Reload / restart / exit
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec ~/Scripts/powermenu-i3

# Gaps (kept modest — low-RAM target, i3's compositing-free gaps are cheap either way)
gaps inner 6
gaps outer 6

# No titlebars — thin pixel border instead (focus still visible via border color)
default_border pixel 2
default_floating_border pixel 2

bar {
    status_command i3blocks
    position top

    colors {
        background          $bg
        statusline           $fg
        separator            $fg-dim

        focused_workspace    $accent $accent $bg
        active_workspace     $lavender $lavender $bg
        inactive_workspace   $bg-alt $bg-alt $fg-dim
        urgent_workspace     $urgent $urgent $fg
    }
}
