! MiniBang theme — single source of truth for terminal + i3 + dmenu.
! i3/dmenu pull these via `set_from_resource` (see .config/i3/config) instead
! of hardcoding hex, so this file is the only place the palette is defined.
*background: #1a1d1e
*foreground: #d8d8d8
*color0:  #1a1d1e
*color1:  #e0623f
*color2:  #3fa796
*color3:  #d9a441
*color4:  #4f8fba
*color5:  #8f7fbd
*color6:  #5fb8ae
*color7:  #d8d8d8
*color8:  #55605e
*color9:  #e0623f
*color10: #3fa796
*color11: #d9a441
*color12: #4f8fba
*color13: #8f7fbd
*color14: #5fb8ae
*color15: #ffffff

! MiniBang i3/dmenu palette (custom resource names, read via set_from_resource)
! Lavender/violet theme: accent = violet (focused), lavender = secondary (active)
*i3.background: #1a1620
*i3.bgAlt:      #3a2f52
*i3.foreground: #ece8f8
*i3.fgDim:      #a99cc4
*i3.accent:     #8b5cf6
*i3.lavender:   #c3bce6
*i3.urgent:     #e0623f

! urxvt - $term in i3 config. Nord theme, scoped to URxvt* so it does not
! touch the shared MiniBang palette above (xterm/i3/dmenu stay as-is).
URxvt.font: xft:DejaVu Sans Mono:size=12
URxvt.internalBorder: 15
! Fixes a urxvt 9.31 regression where the prompt renders mid-window (blank
! space above it) when i3 immediately resizes a new window to full tile
! height. A concrete starting geometry avoids the degenerate default size
! that triggers it. (https://bbs.archlinux.org/viewtopic.php?id=282889)
URxvt.geometry: 80x24
URxvt.perl-ext-common: default,clipboard
URxvt.keysym.C-S-c: clipboard:copy
URxvt.keysym.C-S-v: clipboard:paste
URxvt.letterSpace: 0
URxvt.scrollBar: false
URxvt.saveLines: 5000
URxvt.cursorBlink: true
URxvt.urgentOnBell: true
URxvt.depth: 32
URxvt.iso14755: false

! Nord (https://www.nordtheme.com)
URxvt.background: #2E3440
URxvt.foreground: #D8DEE9
URxvt.cursorColor: #D8DEE9
URxvt.color0:  #3B4252
URxvt.color1:  #BF616A
URxvt.color2:  #A3BE8C
URxvt.color3:  #EBCB8B
URxvt.color4:  #81A1C1
URxvt.color5:  #B48EAD
URxvt.color6:  #88C0D0
URxvt.color7:  #E5E9F0
URxvt.color8:  #4C566A
URxvt.color9:  #BF616A
URxvt.color10: #A3BE8C
URxvt.color11: #EBCB8B
URxvt.color12: #81A1C1
URxvt.color13: #B48EAD
URxvt.color14: #8FBCBB
URxvt.color15: #ECEFF4
