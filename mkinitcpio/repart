#!/bin/bash
# Custom mkinitcpio install hook: bundles systemd-repart and /etc/repart.d/*.conf
# into the initramfs so the root partition can be grown to fill the disk
# BEFORE it is mounted (systemd-repart.service runs in the initrd, prior to
# initrd-root-fs.target). Arch's stock 'systemd' hook does not do this itself.
#
# Must appear after 'systemd' in HOOKS=() in mkinitcpio.conf.

build() {
    add_binary /usr/bin/systemd-repart
    # systemd-repart dlopen()s libfdisk at runtime rather than linking it
    # normally, so mkinitcpio's ldd-based dependency resolution in
    # add_binary never picks it up on its own — bundle it explicitly, or
    # systemd-repart.service fails in the initrd with "Shared library
    # 'libfdisk.so.1' is not available".
    add_binary /usr/lib/libfdisk.so.1
    add_systemd_unit systemd-repart.service

    add_dir /etc/repart.d
    local f
    for f in /etc/repart.d/*.conf; do
        [[ -e $f ]] && add_file "$f" "/etc/repart.d/${f##*/}"
    done
}

help() {
    cat <<HELPEOF
This hook bundles systemd-repart(8) and /etc/repart.d/*.conf into the
initramfs so the root partition table entry can be grown to fill the
underlying block device before the root filesystem is mounted.

Pairs with systemd-growfs-root.service (already shipped in the systemd
package, enabled by default) which grows the filesystem itself after
switch-root.
HELPEOF
}
